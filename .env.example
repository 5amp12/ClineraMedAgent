# Copy to .env at the repo root and fill in real values. .env is gitignored — never commit it,
# and never paste these credentials into source files.

# Clinera AI Service API. No trailing slash, no /api suffix — the client appends the paths.
CLINERA_URL=https://mdtv1-api.everestminds.com

# Auth Method 2 (service account login). POST /api/auth/login returns a session cookie that the
# client reuses for subsequent requests. This is the path we use by default.
CLINERA_AI_SERVICE_EMAIL=
CLINERA_AI_SERVICE_PASSWORD=

# Auth Method 1 (optional, preferred for machine-to-machine if you ever get issued one).
# When set, this long-lived JWT is sent as `Authorization: Bearer <token>` and the login step
# above is skipped entirely.
CLINERA_AI_SERVICE_TOKEN=

# Used by app/pipeline/llm.py for the summarize / agent_reason / draft_recommendations calls.
OPENAI_API_KEY=
